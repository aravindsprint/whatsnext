{
 "doctype": "DocType",
 "name": "Whatsnext Settings",
 "module": "Whatsnext",
 "issingle": 1,
 "custom": 0,
 "engine": "InnoDB",
 "field_order": [
  "default_provider",
  "notify_on_failure",
  "default_country_code",
  "failure_notification_email",
  "section_meta",
  "meta_enabled",
  "meta_phone_number_id",
  "meta_waba_id",
  "meta_app_id",
  "meta_api_version",
  "column_meta_1",
  "meta_access_token",
  "meta_webhook_verify_token",
  "meta_app_secret",
  "section_twilio",
  "twilio_enabled",
  "twilio_account_sid",
  "twilio_whatsapp_number",
  "column_twilio_1",
  "twilio_auth_token",
  "twilio_verify_signature",
  "section_push",
  "push_notifications_enabled",
  "vapid_public_key",
  "column_push_1",
  "vapid_private_key",
  "vapid_subject",
  "section_opt_out",
  "opt_out_enabled",
  "opt_out_keywords",
  "opt_in_keywords",
  "column_opt_out_1",
  "opt_out_confirmation",
  "opt_in_confirmation"
 ],
 "fields": [
  {
   "fieldname": "default_provider",
   "fieldtype": "Select",
   "label": "Default Provider",
   "options": "Meta\nTwilio",
   "default": "Meta",
   "reqd": 1
  },
  {
   "fieldname": "notify_on_failure",
   "fieldtype": "Check",
   "label": "Notify Admin on Send Failure"
  },
  {
   "fieldname": "default_country_code",
   "fieldtype": "Data",
   "label": "Default Country Code",
   "default": "91",
   "description": "Prepended to outbound numbers that look like bare local numbers (no country code), e.g. a 10-digit Indian mobile number. Digits only, no '+'."
  },
  {
   "fieldname": "failure_notification_email",
   "fieldtype": "Data",
   "label": "Failure Notification Email",
   "options": "Email",
   "depends_on": "notify_on_failure"
  },
  {
   "fieldname": "section_meta",
   "fieldtype": "Section Break",
   "label": "Meta WhatsApp Cloud API"
  },
  {
   "fieldname": "meta_enabled",
   "fieldtype": "Check",
   "label": "Enable Meta Cloud API"
  },
  {
   "fieldname": "meta_phone_number_id",
   "fieldtype": "Data",
   "label": "Phone Number ID"
  },
  {
   "fieldname": "meta_waba_id",
   "fieldtype": "Data",
   "label": "WhatsApp Business Account ID"
  },
  {
   "fieldname": "meta_app_id",
   "fieldtype": "Data",
   "label": "App ID"
  },
  {
   "fieldname": "meta_api_version",
   "fieldtype": "Data",
   "label": "Graph API Version",
   "default": "v20.0"
  },
  {
   "fieldname": "column_meta_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "meta_access_token",
   "fieldtype": "Password",
   "label": "Permanent Access Token"
  },
  {
   "fieldname": "meta_webhook_verify_token",
   "fieldtype": "Data",
   "label": "Webhook Verify Token"
  },
  {
   "fieldname": "meta_app_secret",
   "fieldtype": "Password",
   "label": "App Secret (verifies webhook signatures)",
   "description": "From Meta App Dashboard → App settings → Basic. When set, incoming webhooks without a valid X-Hub-Signature-256 are rejected."
  },
  {
   "fieldname": "section_twilio",
   "fieldtype": "Section Break",
   "label": "Twilio WhatsApp API"
  },
  {
   "fieldname": "twilio_enabled",
   "fieldtype": "Check",
   "label": "Enable Twilio"
  },
  {
   "fieldname": "twilio_account_sid",
   "fieldtype": "Data",
   "label": "Account SID"
  },
  {
   "fieldname": "twilio_whatsapp_number",
   "fieldtype": "Data",
   "label": "Twilio WhatsApp Number",
   "description": "e.g. whatsapp:+14155238886"
  },
  {
   "fieldname": "column_twilio_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "twilio_auth_token",
   "fieldtype": "Password",
   "label": "Auth Token"
  },
  {
   "fieldname": "twilio_verify_signature",
   "fieldtype": "Check",
   "label": "Verify Twilio Webhook Signatures",
   "default": "0",
   "description": "Reject Twilio webhooks without a valid X-Twilio-Signature. Turn on once the webhook URLs in Twilio exactly match this site's public URL."
  },
  {
   "fieldname": "section_push",
   "fieldtype": "Section Break",
   "label": "Browser / Mobile Push Notifications"
  },
  {
   "fieldname": "push_notifications_enabled",
   "fieldtype": "Check",
   "label": "Enable Push Notifications",
   "description": "Sends a real OS-level notification (web push) to every subscribed user's device when a new incoming WhatsApp message arrives — even if the browser tab or installed PWA is closed."
  },
  {
   "fieldname": "vapid_public_key",
   "fieldtype": "Small Text",
   "label": "VAPID Public Key",
   "read_only": 1,
   "description": "Auto-generated on first use. Served to the frontend so browsers can create a push subscription."
  },
  {
   "fieldname": "column_push_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "vapid_private_key",
   "fieldtype": "Password",
   "label": "VAPID Private Key",
   "read_only": 1,
   "description": "Auto-generated on first use. Never sent to the frontend — used server-side to sign push messages."
  },
  {
   "fieldname": "vapid_subject",
   "fieldtype": "Data",
   "label": "VAPID Subject (mailto: or https:// contact)",
   "description": "Required by the push spec so push services can contact you about this sender if needed, e.g. mailto:admin@example.com"
  },
  {
   "fieldname": "section_opt_out",
   "fieldtype": "Section Break",
   "label": "Opt-out (STOP / START)"
  },
  {
   "fieldname": "opt_out_enabled",
   "fieldtype": "Check",
   "label": "Handle Opt-out Keywords",
   "default": "1",
   "description": "Customers who reply with an opt-out keyword stop receiving Marketing templates and campaigns."
  },
  {
   "fieldname": "opt_out_keywords",
   "fieldtype": "Small Text",
   "label": "Opt-out Keywords (one per line)",
   "default": "STOP\nUNSUBSCRIBE\nSTOP ALL",
   "depends_on": "opt_out_enabled"
  },
  {
   "fieldname": "opt_in_keywords",
   "fieldtype": "Small Text",
   "label": "Opt-in Keywords (one per line)",
   "default": "START\nSUBSCRIBE",
   "depends_on": "opt_out_enabled"
  },
  {
   "fieldname": "column_opt_out_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opt_out_confirmation",
   "fieldtype": "Small Text",
   "label": "Opt-out Confirmation Reply",
   "default": "You have been unsubscribed and won't receive promotional messages from us. Reply START to subscribe again.",
   "depends_on": "opt_out_enabled"
  },
  {
   "fieldname": "opt_in_confirmation",
   "fieldtype": "Small Text",
   "label": "Opt-in Confirmation Reply",
   "default": "You are subscribed again. Reply STOP to unsubscribe at any time.",
   "depends_on": "opt_out_enabled"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Whatsnext User",
   "read": 1
  }
 ]
}
